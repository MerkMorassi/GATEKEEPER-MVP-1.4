# SERVER CONFIGURATION
PORT=3750

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTHENTICATION
ADMIN_USERNAME="admin"
ADMIN_SECRET_KEY=""
PROVIDER_USERNAME="provider"
PROVIDER_PASSPHRASE=""

# DEVELOPMENT AUTHENTICATION BRIDGE
# Controlled local development only. Disabled in production.
ENABLE_DEV_AUTH="true"
DEV_AUTH_USERNAME="dev_admin"
DEV_AUTH_PASSWORD=""
DEV_AUTH_ROLE="admin"

# TALENTIR PAYOUT ADAPTER CREDENTIALS (Server-side only)
TALENTIR_API_BASE_URL="https://sandbox-api.talentir.com/v1"
TALENTIR_API_KEY=""
TALENTIR_WEBHOOK_SECRET=""
TALENTIR_ENVIRONMENT="sandbox"
TALENTIR_FEE_PERCENTAGE="3.0"

# STRIPE CREDENTIALS (Server-side only)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
